# FRIDAY's one settings + credentials file. Copy it to ~/.friday/.env (just running `friday`), or to .env
# next to docker-compose.yml (the always-on hub). Everything is optional except a way into Claude.

FRIDAY_OWNER_NAME=Ryan
# Only for the hub: the token your devices log in with (`friday login http://<hub>:8080 <token>`).
# Running `friday` on its own makes and keeps a private one for you.
FRIDAY_TOKEN=

# Claude. Either sign in once with `ant auth login` (the hub mounts that profile read-only), or put an API
# key here. A key set here wins over the sign-in.
ANTHROPIC_API_KEY=
FRIDAY_MODEL=claude-opus-5-5

# Raw speech is dropped after the nightly pass unless it scored as worth keeping (0-1).
FRIDAY_RETAIN_DAYS=1
FRIDAY_KEEP_IMPORTANCE=0.5
# 1 keeps other people's words verbatim. Leave 0 unless everyone recorded has consented.
FRIDAY_RECORD_OTHERS=0

# Hours (local, 24h) when only urgent things speak; the rest waits for morning. "0-0" turns it off.
FRIDAY_QUIET_HOURS=22-8
# FRIDAY says hello when you put your headphones on after this many hours away. 0 turns it off.
FRIDAY_GREET_AFTER_HOURS=4

# Voice: en_GB-jenny_dioco-medium is quick; en_GB-cori-high sounds richer but takes ~4x longer per
# sentence. Any Piper voice name works (https://rhasspy.github.io/piper-samples/).
FRIDAY_VOICE=en_GB-jenny_dioco-medium

# Speech recognition size: tiny.en is fastest on a Pi, base.en more accurate, small.en better still.
FRIDAY_WHISPER_MODEL=base.en

# --- plugin credentials -------------------------------------------------------------
# models: which labs count as a "new model drop" (OpenRouter id prefixes). Public, no key.
FRIDAY_MODEL_LABS=anthropic,openai,google,meta-llama,mistralai,deepseek,qwen,x-ai,moonshotai,nousresearch,z-ai
# hermes: Hermes Agent's OpenAI-compatible API server (API_SERVER_ENABLED=true in Hermes).
HERMES_URL=
HERMES_KEY=
