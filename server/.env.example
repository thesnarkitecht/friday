# Required: long random string; every client and room sensor uses it as a bearer token.
FRIDAY_TOKEN=change-me-to-something-long
FRIDAY_OWNER_NAME=Ryan
FRIDAY_DB=friday.db
# Skill folders (SKILL.md, Hermes / agentskills.io format). FRIDAY adds its own here each night.
FRIDAY_SKILLS_DIR=skills
FRIDAY_HOME_LAT=40.7128
FRIDAY_HOME_LON=-74.0060

# Model server: any OpenAI-compatible endpoint with tool calling.
# Blackhole box at home: tt-inference-server (vLLM). Pocket Pi: llama-server --jinja -c 4096 -m <Qwen3-4B Q4>.
# Anthropic's also works: https://api.anthropic.com/v1/
FRIDAY_LLM_BASE_URL=http://localhost:8000/v1
FRIDAY_LLM_API_KEY=none
FRIDAY_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
FRIDAY_FAST_MODEL=
FRIDAY_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Memory: raw low-importance text older than this is dropped after the nightly pass.
FRIDAY_RETAIN_DAYS=30
FRIDAY_KEEP_IMPORTANCE=0.5
# 1 keeps unenrolled speakers' words verbatim. Leave 0 unless everyone recorded has consented.
FRIDAY_RECORD_OTHERS=0

GITHUB_TOKEN=

# Background calls on your behalf. FRIDAY_PUBLIC_URL must be reachable by Twilio (e.g. Tailscale Funnel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FRIDAY_PUBLIC_URL=
